<UserControl x:Class="NasimXray.Client.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- A card that can be clicked (the work queues): hand cursor and an accent border on hover -->
        <Style x:Key="DashCardClickable" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource AccentBrush10}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Dash.Title}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource AccentBrush10}" CornerRadius="12" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="DateText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="UpdatedText" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0" Click="Refresh_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Width="15" Height="15" Data="{StaticResource Icon.Refresh}"/>
                            <TextBlock Text="{DynamicResource Exams.Refresh}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18,24,24">

                <!-- Backup reminder for administrators: when the last backup was made and how long ago (built in code) -->
                <Border x:Name="BackupCard" Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,0,0,18" Visibility="Collapsed"/>

                <TextBlock x:Name="TodayHeading" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,8"/>
                <UniformGrid x:Name="TodayCards" Columns="4" Margin="0,0,-10,8"/>

                <StackPanel x:Name="QueueSection">
                    <TextBlock x:Name="QueueHeading" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,8"/>
                    <UniformGrid x:Name="QueueCards" Columns="3" Margin="0,0,-10,8"/>
                </StackPanel>

                <StackPanel x:Name="MoneySection">
                    <TextBlock x:Name="MoneyHeading" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,8"/>
                    <UniformGrid x:Name="MoneyCards" Columns="2" Margin="0,0,-10,2"/>
                    <Border x:Name="PaymentMixCard" Style="{StaticResource CardBorder}" Margin="0,0,0,18" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dash.PaymentMix}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                            <Grid x:Name="PaymentBar" Height="12"/>
                            <WrapPanel x:Name="PaymentLegend" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="18,16" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dash.ByType}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            <StackPanel x:Name="TypeList"/>
                            <StackPanel x:Name="NoExamsPanel" HorizontalAlignment="Center" Margin="0,18,0,14" Visibility="Collapsed">
                                <Path x:Name="NoExamsIcon" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center"
                                      Fill="{DynamicResource SeparatorBrush}" Data="{StaticResource Icon.Inbox}"/>
                                <TextBlock Text="{DynamicResource Dash.NoExams}" FontSize="13" Margin="0,8,0,0" TextAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18,16" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dash.ByStatus}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            <Grid x:Name="StatusBar" Height="12" Margin="0,0,0,12"/>
                            <StackPanel x:Name="StatusList"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
