<UserControl x:Class="NasimXray.Client.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Dash.Title}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DateText" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="UpdatedText" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="{DynamicResource Exams.Refresh}" Style="{StaticResource SecondaryButton}"
                            Height="34" Padding="14,0" Click="Refresh_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <!-- KPI cards are built in code (they depend on the user's permissions and the language) -->
                <WrapPanel x:Name="Cards"/>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dash.ByType}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                            <DataGrid x:Name="TypeGrid" Style="{StaticResource ModernDataGrid}" IsReadOnly="True"
                                      AutoGenerateColumns="False" VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="Grid_PreviewMouseWheel">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource Exams.ExamType}" Binding="{Binding ExamTypeName}" Width="2*"/>
                                    <DataGridTextColumn Header="{DynamicResource Exams.Modality}" Binding="{Binding Modality}" Width="*"/>
                                    <DataGridTextColumn Header="{DynamicResource Stats.Col.Exams}" Binding="{Binding ExamCount}" Width="80"/>
                                    <DataGridTextColumn Header="{DynamicResource Stats.Col.Patients}" Binding="{Binding PatientCount}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="NoExamsText" Text="{DynamicResource Dash.NoExams}" FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Dash.ByStatus}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                <StackPanel x:Name="StatusList"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="MoneyCard" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Dash.Money}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                <StackPanel x:Name="MoneyList"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
