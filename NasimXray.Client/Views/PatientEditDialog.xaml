<Window x:Class="NasimXray.Client.Views.PatientEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NasimXray.Client.Helpers"
        xmlns:shared="clr-namespace:NasimXray.Client.Views.Shared"
        x:Name="RootWindow"
        Title="{DynamicResource PatientEdit.NewTitle}"
        Height="480" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FlowDirection="{Binding Source={x:Static helpers:AppSessionProxy.Instance}, Path=FlowDirection}">
    <Border Style="{StaticResource CardBorder}" Margin="16">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

            <TextBlock Text="{DynamicResource PatientEdit.FullName}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="FullNameBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Patients.DateOfBirth}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <!-- Dual-control pattern: both stay in sync (the Shamsi picker binds to DobPicker's
                         SelectedDate, so the code-behind keeps reading/writing DobPicker alone) and
                         the active calendar decides which one is visible. -->
                    <Grid>
                        <DatePicker x:Name="DobPicker" Height="38"
                                    Visibility="{Binding Source={x:Static helpers:AppSessionProxy.Instance}, Path=IsShamsi, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <shared:AfghanShamsiDatePicker Height="38"
                                    SelectedDate="{Binding SelectedDate, ElementName=DobPicker, Mode=TwoWay}"
                                    Visibility="{Binding Source={x:Static helpers:AppSessionProxy.Instance}, Path=IsShamsi, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Patients.Sex}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="SexBox" Style="{StaticResource ModernComboBox}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="{DynamicResource Patients.Phone}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="PhoneBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12" FlowDirection="LeftToRight"/>

            <TextBlock Text="{DynamicResource PatientEdit.Address}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="AddressBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"/>

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{DynamicResource PatientEdit.Cancel}" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="{DynamicResource PatientEdit.Save}" Style="{StaticResource PrimaryButton}"
                        Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
