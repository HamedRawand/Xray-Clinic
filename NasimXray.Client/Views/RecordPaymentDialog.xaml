<Window x:Class="NasimXray.Client.Views.RecordPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NasimXray.Client.Helpers"
        Title="{DynamicResource RecordPayment.Title}"
        Height="340" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FlowDirection="{Binding Source={x:Static helpers:AppSessionProxy.Instance}, Path=FlowDirection}">
    <Border Style="{StaticResource CardBorder}" Margin="16">
        <StackPanel>
            <TextBlock x:Name="BalanceText" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12"/>

            <TextBlock Text="{DynamicResource RecordPayment.Amount}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="AmountBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12" FlowDirection="LeftToRight"/>

            <TextBlock Text="{DynamicResource RecordPayment.Method}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <ComboBox x:Name="MethodBox" Style="{StaticResource ModernComboBox}" Margin="0,0,0,4"/>

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{DynamicResource PatientEdit.Cancel}" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="{DynamicResource RecordPayment.Submit}" Style="{StaticResource PrimaryButton}"
                        Click="Submit_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
