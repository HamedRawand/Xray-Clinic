<Window x:Class="NasimXray.Client.Views.NewExamOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NasimXray.Client.Helpers"
        Title="{DynamicResource NewExamOrder.Title}"
        Height="340" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FlowDirection="{Binding Source={x:Static helpers:AppSessionProxy.Instance}, Path=FlowDirection}">
    <Border Style="{StaticResource CardBorder}" Margin="16">
        <StackPanel>
            <TextBlock Text="{DynamicResource NewExamOrder.ExamType}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <ComboBox x:Name="ExamTypeBox" Style="{StaticResource ModernComboBox}" Margin="0,0,0,12"
                      DisplayMemberPath="Name"/>

            <TextBlock Text="{DynamicResource NewExamOrder.ReferringPhysician}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <ComboBox x:Name="ReferringPhysicianBox" Style="{StaticResource ModernComboBox}" Margin="0,0,0,4"
                      DisplayMemberPath="Name"/>

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{DynamicResource PatientEdit.Cancel}" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="{DynamicResource NewExamOrder.Create}" Style="{StaticResource PrimaryButton}"
                        Click="Create_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
