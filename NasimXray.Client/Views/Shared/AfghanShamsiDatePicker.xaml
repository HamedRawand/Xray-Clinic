<UserControl x:Class="NasimXray.Client.Views.Shared.AfghanShamsiDatePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="ThisControl">

    <UserControl.Resources>
        <!-- Flat round day cell -->
        <ControlTemplate x:Key="DayBtnTemplate" TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="16">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="Tag" Value="normal"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                </MultiTrigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#BFDBFE"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Nav arrow button -->
        <ControlTemplate x:Key="NavBtnTemplate" TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>

    <Border x:Name="RootBorder"
            Background="{DynamicResource InputBackgroundBrush}"
            BorderBrush="{DynamicResource InputBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="32"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="DateTextBlock"
                       Grid.Column="0"
                       Padding="10,0"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontFamily="Segoe UI"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FlowDirection="LeftToRight"/>

            <Button Grid.Column="1"
                    x:Name="CalendarToggleButton"
                    Template="{StaticResource NavBtnTemplate}"
                    Cursor="Hand"
                    Focusable="False"
                    Click="CalendarToggleButton_Click">
                <Viewbox Width="14" Height="14">
                    <Canvas Width="24" Height="24">
                        <Path Fill="{DynamicResource TextMutedBrush}"
                              Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z"/>
                    </Canvas>
                </Viewbox>
            </Button>

            <Popup x:Name="CalendarPopup"
                   PlacementTarget="{Binding ElementName=RootBorder}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   VerticalOffset="2">
                <Border Background="#FFFFFF"
                        CornerRadius="8"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Padding="10"
                        Width="268"
                        FlowDirection="LeftToRight">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="3"
                                          Color="#1E3A8A" Opacity="0.12"/>
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="PrevMonthBtn"
                                    Template="{StaticResource NavBtnTemplate}"
                                    Cursor="Hand" Focusable="False"
                                    Click="PrevMonth_Click" ToolTip="ماه قبل">
                                <Viewbox Width="10" Height="10">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#475569"
                                              Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <TextBlock x:Name="MonthYearLabel" Grid.Column="1"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#1E293B" FlowDirection="RightToLeft"/>
                            <Button Grid.Column="2" x:Name="NextMonthBtn"
                                    Template="{StaticResource NavBtnTemplate}"
                                    Cursor="Hand" Focusable="False"
                                    Click="NextMonth_Click" ToolTip="ماه بعد">
                                <Viewbox Width="10" Height="10">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#475569"
                                              Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>
                        <UniformGrid x:Name="DayNamesGrid" Rows="1" Columns="7" Margin="0,0,0,4"/>
                        <UniformGrid x:Name="DaysGrid" Rows="6" Columns="7"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
