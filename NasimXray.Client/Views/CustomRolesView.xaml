<UserControl x:Class="NasimXray.Client.Views.CustomRolesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <TextBlock Text="{DynamicResource CustomRoles.Title}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <Button Content="{DynamicResource CustomRoles.New}" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right" Click="New_Click"/>
            </Grid>
        </Border>

        <DataGrid x:Name="Grid" Style="{StaticResource ModernDataGrid}" Margin="24"
                  AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="Grid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource CustomRoles.Name}" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource CustomRoles.Description}" Binding="{Binding Description}" Width="2*"/>
                <DataGridTextColumn Header="{DynamicResource CustomRoles.Permissions}" Binding="{Binding Permissions.Count}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
