<Window x:Class="NasimXray.Client.Views.InvoiceDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NasimXray.Client.Helpers"
        Title="{DynamicResource InvoiceDetail.TitlePrefix}"
        Height="640" Width="620" MinHeight="480" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        FlowDirection="{Binding Source={x:Static helpers:AppSessionProxy.Instance}, Path=FlowDirection}">
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="PatientText" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource InvoiceDetail.PrintReceipt}" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" Click="PrintReceipt_Click"/>
                <Button Content="{DynamicResource PatientDetail.Close}" Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Invoices.Total}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="TotalText" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{DynamicResource Invoices.Paid}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="PaidText" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Invoices.Balance}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="BalanceText" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource InvoiceDetail.Lines}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="LinesPanel"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource InvoiceDetail.Payments}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="RecordPaymentButton" Content="{DynamicResource InvoiceDetail.RecordPayment}"
                                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                                    Height="32" Padding="12,0" FontSize="12" Click="RecordPayment_Click"/>
                        </Grid>

                        <TextBlock x:Name="FullyPaidText" Text="{DynamicResource InvoiceDetail.FullyPaid}"
                                   FontSize="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,8" Visibility="Collapsed"/>
                        <TextBlock x:Name="NoPaymentsText" Text="{DynamicResource InvoiceDetail.NoPayments}"
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed"/>

                        <ItemsControl x:Name="PaymentsPanel"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
