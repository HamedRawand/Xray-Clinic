<Window x:Class="NasimXray.Client.Views.ExamTypeEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NasimXray.Client.Helpers"
        x:Name="RootWindow"
        Title="{DynamicResource ExamTypes.New}"
        Height="620" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FlowDirection="{Binding Source={x:Static helpers:AppSessionProxy.Instance}, Path=FlowDirection}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                <TextBlock Text="{DynamicResource ExamTypes.Name}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource ExamTypes.Modality}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ModalityBox" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource ExamTypes.BodyPart}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="BodyPartBox" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="{DynamicResource ExamTypes.PriceAfn}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="PriceBox" Style="{StaticResource ModernTextBox}" FlowDirection="LeftToRight"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="ActiveBox" Content="{DynamicResource ExamTypes.Active}" IsChecked="True" Margin="0,0,0,8"/>

                <TextBlock x:Name="TopErrorText" Foreground="{DynamicResource DangerBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>

                <Button Content="{DynamicResource PatientEdit.Save}" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right" Margin="0,8,0,0" Click="SaveBasic_Click"/>
            </StackPanel>
        </Border>

        <Border x:Name="FieldsSection" Grid.Row="1" Style="{StaticResource CardBorder}" Visibility="Collapsed">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="{DynamicResource ExamTypes.Fields}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Button Content="{DynamicResource ExamTypes.AddField}" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Right" Height="30" Padding="10,0" FontSize="12" Click="AddField_Click"/>
                </Grid>

                <TextBlock x:Name="NoFieldsText" DockPanel.Dock="Top" Text="{DynamicResource ExamTypes.NoFields}"
                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                           Margin="0,0,0,8" Visibility="Collapsed"/>

                <DataGrid x:Name="FieldsGrid" Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="FieldsGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource ExamTypes.FieldLabel}" Binding="{Binding Label}" Width="2*"/>
                        <DataGridTextColumn Header="{DynamicResource ExamTypes.FieldKey}" Binding="{Binding FieldKey}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource ExamTypes.FieldUnit}" Binding="{Binding Unit}" Width="70"/>
                        <DataGridTextColumn Header="{DynamicResource ExamTypes.FieldType}" Binding="{Binding DataType}" Width="80"/>
                        <DataGridTextColumn Header="{DynamicResource ExamTypes.FieldOrder}" Binding="{Binding DisplayOrder}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Button Grid.Row="2" Content="{DynamicResource PatientDetail.Close}" Style="{StaticResource SecondaryButton}"
                HorizontalAlignment="Right" Margin="0,12,0,0" Click="Close_Click"/>
    </Grid>
</Window>
