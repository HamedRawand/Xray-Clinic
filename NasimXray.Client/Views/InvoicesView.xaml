<UserControl x:Class="NasimXray.Client.Views.InvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <TextBlock Text="{DynamicResource Invoices.Title}" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </Border>

        <Grid>
            <DataGrid x:Name="Grid" Style="{StaticResource ModernDataGrid}" Margin="24"
                      AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="Grid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Invoices.Patient}" Binding="{Binding PatientName}" Width="2*"/>
                    <DataGridTextColumn Header="{DynamicResource Invoices.Total}" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="100"/>
                    <DataGridTextColumn Header="{DynamicResource Invoices.Paid}" Binding="{Binding AmountPaid, StringFormat={}{0:N2}}" Width="100"/>
                    <DataGridTextColumn Header="{DynamicResource Invoices.Balance}" Binding="{Binding Balance, StringFormat={}{0:N2}}" Width="100"/>
                    <DataGridTextColumn Header="{DynamicResource Invoices.Status}" Binding="{Binding Status, Converter={StaticResource InvoiceStatusToLocalizedConverter}}" Width="120"/>
                    <DataGridTextColumn Header="{DynamicResource Invoices.Date}" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd}" Width="110"/>
                    <DataGridTemplateColumn Header="" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{DynamicResource Invoices.Open}" Style="{StaticResource SecondaryButton}"
                                        Height="28" Padding="10,0" FontSize="11" Click="Open_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="EmptyText" Text="{DynamicResource Invoices.Empty}" Visibility="Collapsed"
                       FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </DockPanel>
</UserControl>
