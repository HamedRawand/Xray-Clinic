<UserControl x:Class="NasimXray.Client.Views.InvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:NasimXray.Client.Helpers"
             xmlns:shared="clr-namespace:NasimXray.Client.Views.Shared">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Invoices.Title}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,24,0"/>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{DynamicResource Invoices.Search}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="SearchBox" Style="{StaticResource ModernTextBox}" Width="300"
                             TextChanged="SearchBox_TextChanged"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Invoices.Status}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="StatusBox" Style="{StaticResource ModernComboBox}" Width="170" SelectedIndex="0"
                              SelectionChanged="StatusBox_SelectionChanged">
                        <ComboBoxItem Content="{DynamicResource Invoices.AllStatuses}"/>
                        <ComboBoxItem Tag="Unpaid" Content="{DynamicResource InvoiceStatus.Unpaid}"/>
                        <ComboBoxItem Tag="PartiallyPaid" Content="{DynamicResource InvoiceStatus.PartiallyPaid}"/>
                        <ComboBoxItem Tag="Paid" Content="{DynamicResource InvoiceStatus.Paid}"/>
                    </ComboBox>
                </StackPanel>
                <Button Content="{DynamicResource Stats.Export}" Style="{StaticResource SecondaryButton}"
                        Height="38" Padding="14,0" Margin="12,0,0,0" VerticalAlignment="Bottom" Click="Export_Click"/>
            </StackPanel>
        </Border>

        <shared:PagerControl x:Name="Pager" DockPanel.Dock="Bottom"/>

        <!-- Totals over ALL invoices matching the filters (not just this page) -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Padding="24,10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock x:Name="TotalsCaption" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,28,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,28,0">
                    <TextBlock Text="{DynamicResource Invoices.Total}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="SumTotalText" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,28,0">
                    <TextBlock Text="{DynamicResource Invoices.Paid}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="SumPaidText" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Invoices.Balance}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="SumBalanceText" FontSize="15" FontWeight="Bold"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <Grid>
            <DataGrid x:Name="Grid" Style="{StaticResource ModernDataGrid}" Margin="24"
                      AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="Grid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Invoices.Patient}" Binding="{Binding PatientName}" Width="2*"/>
                    <DataGridTextColumn Header="{DynamicResource Invoices.Total}" Binding="{Binding Total, Converter={StaticResource MoneyConverter}}" Width="130"/>
                    <DataGridTextColumn Header="{DynamicResource Invoices.Paid}" Binding="{Binding AmountPaid, Converter={StaticResource MoneyConverter}}" Width="130"/>
                    <DataGridTextColumn Header="{DynamicResource Invoices.Balance}" Binding="{Binding Balance, Converter={StaticResource MoneyConverter}}" Width="130"/>
                    <DataGridTemplateColumn Header="{DynamicResource Invoices.Status}" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <shared:StatusBadge Margin="8,0"
                                    Text="{Binding Status, Converter={StaticResource InvoiceStatusToLocalizedConverter}}"
                                    Kind="{Binding Status, Converter={StaticResource StatusToBadgeKindConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{DynamicResource Invoices.Date}" Width="110">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource DateToCalendarConverter}" ConverterParameter="date" Mode="OneWay">
                                <Binding Path="CreatedAt"/>
                                <Binding Source="{x:Static helpers:AppSessionProxy.Instance}" Path="IsShamsi"/>
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{DynamicResource Invoices.Open}" Style="{StaticResource SecondaryButton}"
                                        Height="28" Padding="10,0" FontSize="11" Click="Open_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="EmptyText" Text="{DynamicResource Invoices.Empty}" Visibility="Collapsed"
                       FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </DockPanel>
</UserControl>
