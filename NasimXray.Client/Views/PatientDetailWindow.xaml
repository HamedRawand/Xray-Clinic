<Window x:Class="NasimXray.Client.Views.PatientDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NasimXray.Client.Helpers"
        xmlns:shared="clr-namespace:NasimXray.Client.Views.Shared"
        Title="{DynamicResource PatientDetail.TitlePrefix}"
        Height="600" Width="900" MinHeight="450" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        FlowDirection="{Binding Source={x:Static helpers:AppSessionProxy.Instance}, Path=FlowDirection}">
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="PatientNameText" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource AccentBrush20}" CornerRadius="10" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PatientCodeText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="NewInvoiceButton" Content="{DynamicResource PatientDetail.NewInvoice}" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" Click="NewInvoice_Click"/>
                <Button x:Name="NewExamOrderButton" Content="{DynamicResource PatientDetail.NewExamOrder}" Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0" Click="NewExamOrder_Click"/>
                <Button Content="{DynamicResource PatientDetail.Close}" Style="{StaticResource SecondaryButton}"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <Grid>
            <DataGrid x:Name="Grid" Style="{StaticResource ModernDataGrid}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource PatientDetail.ExamType}" Binding="{Binding ExamTypeName}" Width="2*"/>
                    <DataGridTemplateColumn Header="{DynamicResource PatientDetail.Status}" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <shared:StatusBadge Margin="8,0"
                                    Text="{Binding Status, Converter={StaticResource StatusToLocalizedConverter}}"
                                    Kind="{Binding Status, Converter={StaticResource StatusToBadgeKindConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{DynamicResource PatientDetail.Referring}" Binding="{Binding ReferringPhysicianName}" Width="*"/>
                    <DataGridTextColumn Header="{DynamicResource PatientDetail.Requested}" Width="110">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource DateToCalendarConverter}" ConverterParameter="date" Mode="OneWay">
                                <Binding Path="CreatedAt"/>
                                <Binding Source="{x:Static helpers:AppSessionProxy.Instance}" Path="IsShamsi"/>
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="{DynamicResource Exams.Charge}" Width="115">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NetPrice, Converter={StaticResource MoneyConverter}}" VerticalAlignment="Center" Margin="8,0"
                                           ToolTip="{Binding DiscountReason}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDiscounted}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="DiscountColumn" Header="" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{DynamicResource Exams.Discount}" Style="{StaticResource SecondaryButton}"
                                        Height="28" Padding="10,0" FontSize="11" Click="Discount_Click"
                                        Visibility="{Binding IsDiscountable, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="ReportColumn" Header="" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{DynamicResource PatientDetail.OpenReport}" Style="{StaticResource SecondaryButton}"
                                        Height="28" Padding="10,0" FontSize="11" Click="OpenReport_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="EmptyText" Text="{DynamicResource PatientDetail.Empty}" Visibility="Collapsed"
                       FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </DockPanel>
</Window>
