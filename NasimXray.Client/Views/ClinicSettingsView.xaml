<UserControl x:Class="NasimXray.Client.Views.ClinicSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <TextBlock Text="{DynamicResource ClinicSettings.Title}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <Button x:Name="SaveButton" Content="{DynamicResource ClinicSettings.Save}" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right" Padding="28,0" Click="Save_Click"/>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" MaxWidth="760" HorizontalAlignment="Left">

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ClinicSettings.Identity}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                        <TextBlock Text="{DynamicResource ClinicSettings.NameEnglish}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="NameEnglishBox" Style="{StaticResource ModernTextBox}" MaxLength="150"
                                 FlowDirection="LeftToRight" Margin="0,0,0,12"/>

                        <TextBlock Text="{DynamicResource ClinicSettings.NameDari}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="NameDariBox" Style="{StaticResource ModernTextBox}" MaxLength="150"
                                 FlowDirection="RightToLeft" Margin="0,0,0,12"/>

                        <TextBlock Text="{DynamicResource ClinicSettings.Tagline}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TaglineBox" Style="{StaticResource ModernTextBox}" MaxLength="200"
                                 FlowDirection="LeftToRight" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource ClinicSettings.TaglineHint}" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ClinicSettings.Contact}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                        <TextBlock Text="{DynamicResource ClinicSettings.Address}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="AddressBox" Style="{StaticResource ModernTextBox}" MaxLength="250" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ClinicSettings.Phone}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="PhoneBox" Style="{StaticResource ModernTextBox}" MaxLength="100" FlowDirection="LeftToRight"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource ClinicSettings.Email}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="EmailBox" Style="{StaticResource ModernTextBox}" MaxLength="100" FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ClinicSettings.Logo}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="150" Height="90" CornerRadius="8" BorderThickness="1" Margin="0,0,16,0"
                                    BorderBrush="{DynamicResource SeparatorBrush}" Background="{DynamicResource PrimaryBrush}">
                                <Grid>
                                    <Image x:Name="LogoPreview" Stretch="Uniform" Margin="8"/>
                                    <TextBlock x:Name="NoLogoText" Text="{DynamicResource ClinicSettings.NoLogo}" FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="{DynamicResource ClinicSettings.ChooseLogo}" Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,8,0" Click="ChooseLogo_Click"/>
                                    <Button x:Name="RemoveLogoButton" Content="{DynamicResource ClinicSettings.RemoveLogo}"
                                            Style="{StaticResource SecondaryButton}" Click="RemoveLogo_Click"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource ClinicSettings.LogoHint}" FontSize="11" MaxWidth="420"
                                           Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
