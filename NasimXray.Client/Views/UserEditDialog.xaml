<Window x:Class="NasimXray.Client.Views.UserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NasimXray.Client.Helpers"
        Title="{DynamicResource UserEdit.NewTitle}"
        Height="540" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FlowDirection="{Binding Source={x:Static helpers:AppSessionProxy.Instance}, Path=FlowDirection}">
    <Border Style="{StaticResource CardBorder}" Margin="16">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

            <TextBlock Text="{DynamicResource Users.Username}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="UsernameBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10" FlowDirection="LeftToRight"/>

            <StackPanel x:Name="PasswordPanel">
                <TextBlock Text="{DynamicResource UserEdit.Password}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,10" FlowDirection="LeftToRight"/>
            </StackPanel>

            <TextBlock Text="{DynamicResource Users.FullName}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="FullNameBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>

            <TextBlock Text="{DynamicResource UserEdit.BuiltInRole}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <ComboBox x:Name="RoleBox" Style="{StaticResource ModernComboBox}" Margin="0,0,0,10"/>

            <TextBlock Text="{DynamicResource UserEdit.CustomRole}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <ComboBox x:Name="CustomRoleBox" Style="{StaticResource ModernComboBox}" Margin="0,0,0,10"/>

            <CheckBox x:Name="ActiveBox" Content="{DynamicResource ExamTypes.Active}" IsChecked="True" Margin="0,0,0,4"/>

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{DynamicResource PatientEdit.Cancel}" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="{DynamicResource PatientEdit.Save}" Style="{StaticResource PrimaryButton}"
                        Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
