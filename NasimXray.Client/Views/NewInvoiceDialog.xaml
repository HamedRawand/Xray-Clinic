<Window x:Class="NasimXray.Client.Views.NewInvoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NasimXray.Client.Helpers"
        Title="{DynamicResource NewInvoice.Title}"
        Height="480" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FlowDirection="{Binding Source={x:Static helpers:AppSessionProxy.Instance}, Path=FlowDirection}">
    <Border Style="{StaticResource CardBorder}" Margin="16">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource NewInvoice.SelectOrders}" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <TextBlock x:Name="NoneText" DockPanel.Dock="Top" Text="{DynamicResource NewInvoice.None}"
                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <TextBlock x:Name="TotalText" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                           FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="{DynamicResource PatientEdit.Cancel}" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" IsCancel="True"/>
                    <Button Content="{DynamicResource NewInvoice.Create}" Style="{StaticResource PrimaryButton}"
                            Click="Create_Click"/>
                </StackPanel>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="OrdersPanel"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
