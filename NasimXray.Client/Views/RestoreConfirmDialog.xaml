<Window x:Class="NasimXray.Client.Views.RestoreConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NasimXray.Client.Helpers"
        Title="{DynamicResource RestoreConfirm.Title}"
        Height="440" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FlowDirection="{Binding Source={x:Static helpers:AppSessionProxy.Instance}, Path=FlowDirection}">
    <Border Style="{StaticResource CardBorder}" Margin="16">
        <StackPanel>
            <Border Background="#FEE2E2" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                <TextBlock Text="{DynamicResource RestoreConfirm.Warning}" FontSize="12"
                           Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontWeight="SemiBold"/>
            </Border>

            <TextBlock x:Name="FileText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <TextBlock Text="{DynamicResource RestoreConfirm.Password}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,12" FlowDirection="LeftToRight"/>

            <TextBlock Text="{DynamicResource RestoreConfirm.TypeToConfirm}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="ConfirmBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,4" FlowDirection="LeftToRight"/>

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{DynamicResource PatientEdit.Cancel}" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="{DynamicResource RestoreConfirm.Submit}" Style="{StaticResource DangerButton}"
                        Click="Submit_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
