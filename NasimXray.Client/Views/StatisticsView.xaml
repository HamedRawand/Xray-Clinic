<UserControl x:Class="NasimXray.Client.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:NasimXray.Client.Helpers"
             xmlns:shared="clr-namespace:NasimXray.Client.Views.Shared">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="24,14,24,6">
            <StackPanel>
                <TextBlock Text="{DynamicResource Stats.Title}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                <WrapPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{DynamicResource Exams.DateRange}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="PresetBox" Style="{StaticResource ModernComboBox}" Width="150"
                                  SelectionChanged="PresetBox_SelectionChanged">
                            <ComboBoxItem Tag="today" Content="{DynamicResource Exams.Preset.Today}"/>
                            <ComboBoxItem Tag="yesterday" Content="{DynamicResource Exams.Preset.Yesterday}"/>
                            <ComboBoxItem Tag="week" Content="{DynamicResource Exams.Preset.Week}"/>
                            <ComboBoxItem Tag="month" Content="{DynamicResource Exams.Preset.Month}"/>
                            <ComboBoxItem Tag="last30" Content="{DynamicResource Stats.Preset.Last30}"/>
                            <ComboBoxItem Tag="year" Content="{DynamicResource Stats.Preset.Year}"/>
                            <ComboBoxItem Tag="custom" Content="{DynamicResource Exams.Preset.Custom}"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{DynamicResource Exams.From}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Grid Width="140">
                            <DatePicker x:Name="FromPicker" Height="38" SelectedDateChanged="DatePicker_Changed"
                                        Visibility="{Binding Source={x:Static helpers:AppSessionProxy.Instance}, Path=IsShamsi, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            <shared:AfghanShamsiDatePicker Height="38"
                                        SelectedDate="{Binding SelectedDate, ElementName=FromPicker, Mode=TwoWay}"
                                        Visibility="{Binding Source={x:Static helpers:AppSessionProxy.Instance}, Path=IsShamsi, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{DynamicResource Exams.To}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Grid Width="140">
                            <DatePicker x:Name="ToPicker" Height="38" SelectedDateChanged="DatePicker_Changed"
                                        Visibility="{Binding Source={x:Static helpers:AppSessionProxy.Instance}, Path=IsShamsi, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            <shared:AfghanShamsiDatePicker Height="38"
                                        SelectedDate="{Binding SelectedDate, ElementName=ToPicker, Mode=TwoWay}"
                                        Visibility="{Binding Source={x:Static helpers:AppSessionProxy.Instance}, Path=IsShamsi, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8" VerticalAlignment="Bottom" Orientation="Horizontal">
                        <Button Content="{DynamicResource Exams.Refresh}" Style="{StaticResource SecondaryButton}"
                                Height="38" Padding="14,0" Margin="0,0,8,0" Click="Refresh_Click"/>
                        <Button x:Name="ExportButton" Content="{DynamicResource Stats.Export}" Style="{StaticResource PrimaryButton}"
                                Height="38" Padding="16,0" Click="Export_Click"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <WrapPanel x:Name="Cards" Margin="0,0,0,4"/>
                <TextBlock x:Name="NoteText" Text="{DynamicResource Stats.Note}" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Stats.ByType}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="TypeGrid" Style="{StaticResource ModernDataGrid}" IsReadOnly="True"
                                  AutoGenerateColumns="False" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="Grid_PreviewMouseWheel">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Exams.ExamType}" Binding="{Binding Label}" Width="3*"/>
                                <DataGridTextColumn Header="{DynamicResource Stats.Col.Exams}" Binding="{Binding Exams}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource Stats.Col.Patients}" Binding="{Binding Patients}" Width="*"/>
                                <DataGridTextColumn x:Name="TypeRevenue" Header="{DynamicResource Stats.Col.Revenue}" Binding="{Binding Revenue, Converter={StaticResource MoneyConverter}}" Width="*"/>
                                <DataGridTextColumn x:Name="TypeDiscount" Header="{DynamicResource Stats.Col.Discount}" Binding="{Binding Discount, Converter={StaticResource MoneyConverter}}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Stats.ByModality}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="ModalityGrid" Style="{StaticResource ModernDataGrid}" IsReadOnly="True"
                                  AutoGenerateColumns="False" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="Grid_PreviewMouseWheel">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Exams.Modality}" Binding="{Binding Label}" Width="3*"/>
                                <DataGridTextColumn Header="{DynamicResource Stats.Col.Exams}" Binding="{Binding Exams}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource Stats.Col.Patients}" Binding="{Binding Patients}" Width="*"/>
                                <DataGridTextColumn x:Name="ModalityRevenue" Header="{DynamicResource Stats.Col.Revenue}" Binding="{Binding Revenue, Converter={StaticResource MoneyConverter}}" Width="*"/>
                                <DataGridTextColumn x:Name="ModalityDiscount" Header="{DynamicResource Stats.Col.Discount}" Binding="{Binding Discount, Converter={StaticResource MoneyConverter}}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Stats.ByDoctor}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="DoctorGrid" Style="{StaticResource ModernDataGrid}" IsReadOnly="True"
                                  AutoGenerateColumns="False" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="Grid_PreviewMouseWheel">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Exams.Referring}" Binding="{Binding Label}" Width="3*"/>
                                <DataGridTextColumn Header="{DynamicResource Stats.Col.Exams}" Binding="{Binding Exams}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource Stats.Col.Patients}" Binding="{Binding Patients}" Width="*"/>
                                <DataGridTextColumn x:Name="DoctorRevenue" Header="{DynamicResource Stats.Col.Revenue}" Binding="{Binding Revenue, Converter={StaticResource MoneyConverter}}" Width="*"/>
                                <DataGridTextColumn x:Name="DoctorDiscount" Header="{DynamicResource Stats.Col.Discount}" Binding="{Binding Discount, Converter={StaticResource MoneyConverter}}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Stats.ByDay}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="DayGrid" Style="{StaticResource ModernDataGrid}" IsReadOnly="True"
                                  AutoGenerateColumns="False" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="Grid_PreviewMouseWheel">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Stats.Col.Date}" Binding="{Binding Date}" Width="3*"/>
                                <DataGridTextColumn Header="{DynamicResource Stats.Col.Exams}" Binding="{Binding Exams}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource Stats.Col.Patients}" Binding="{Binding Patients}" Width="*"/>
                                <DataGridTextColumn x:Name="DayCollected" Header="{DynamicResource Stats.Col.Collected}" Binding="{Binding Collected, Converter={StaticResource MoneyConverter}}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border x:Name="CashCard" Style="{StaticResource CardBorder}" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Stats.CashByUser}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="CashGrid" Style="{StaticResource ModernDataGrid}" IsReadOnly="True"
                                  AutoGenerateColumns="False" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="Grid_PreviewMouseWheel">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Stats.Col.User}" Binding="{Binding UserName}" Width="2*"/>
                                <DataGridTextColumn Header="{DynamicResource Stats.Col.Payments}" Binding="{Binding Payments}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource PaymentMethod.Cash}" Binding="{Binding Cash, Converter={StaticResource MoneyConverter}}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource PaymentMethod.Card}" Binding="{Binding Card, Converter={StaticResource MoneyConverter}}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource PaymentMethod.Other}" Binding="{Binding Other, Converter={StaticResource MoneyConverter}}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource Stats.Col.Total}" Binding="{Binding Total, Converter={StaticResource MoneyConverter}}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border x:Name="DiscountCard" Style="{StaticResource CardBorder}" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Stats.DiscountsByUser}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="DiscountGrid" Style="{StaticResource ModernDataGrid}" IsReadOnly="True"
                                  AutoGenerateColumns="False" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="Grid_PreviewMouseWheel">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Stats.Col.User}" Binding="{Binding UserName}" Width="2*"/>
                                <DataGridTextColumn Header="{DynamicResource Stats.Col.Exams}" Binding="{Binding Exams}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource Stats.Col.FreeExams}" Binding="{Binding FreeExams}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource Stats.Col.Discount}" Binding="{Binding Amount, Converter={StaticResource MoneyConverter}}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
