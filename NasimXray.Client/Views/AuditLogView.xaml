<UserControl x:Class="NasimXray.Client.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:NasimXray.Client.Helpers"
             xmlns:shared="clr-namespace:NasimXray.Client.Views.Shared">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="24,14,24,6">
            <StackPanel>
                <TextBlock Text="{DynamicResource AuditLog.Title}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                <WrapPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{DynamicResource AuditLog.Search}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="SearchBox" Style="{StaticResource ModernTextBox}" Width="260"
                                 TextChanged="SearchBox_TextChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{DynamicResource AuditLog.Action}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ActionBox" Style="{StaticResource ModernComboBox}" Width="220"
                                  DisplayMemberPath="Label" SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{DynamicResource Exams.From}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Grid Width="140">
                            <DatePicker x:Name="FromPicker" Height="38" SelectedDateChanged="DatePicker_Changed"
                                        Visibility="{Binding Source={x:Static helpers:AppSessionProxy.Instance}, Path=IsShamsi, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            <shared:AfghanShamsiDatePicker Height="38"
                                        SelectedDate="{Binding SelectedDate, ElementName=FromPicker, Mode=TwoWay}"
                                        Visibility="{Binding Source={x:Static helpers:AppSessionProxy.Instance}, Path=IsShamsi, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{DynamicResource Exams.To}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Grid Width="140">
                            <DatePicker x:Name="ToPicker" Height="38" SelectedDateChanged="DatePicker_Changed"
                                        Visibility="{Binding Source={x:Static helpers:AppSessionProxy.Instance}, Path=IsShamsi, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            <shared:AfghanShamsiDatePicker Height="38"
                                        SelectedDate="{Binding SelectedDate, ElementName=ToPicker, Mode=TwoWay}"
                                        Visibility="{Binding Source={x:Static helpers:AppSessionProxy.Instance}, Path=IsShamsi, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8" VerticalAlignment="Bottom" Orientation="Horizontal">
                        <Button Content="{DynamicResource Exams.Clear}" Style="{StaticResource SecondaryButton}"
                                Height="38" Padding="14,0" Margin="0,0,8,0" Click="Clear_Click"/>
                        <Button Content="{DynamicResource Exams.Refresh}" Style="{StaticResource SecondaryButton}"
                                Height="38" Padding="14,0" Click="Refresh_Click"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <shared:PagerControl x:Name="Pager" DockPanel.Dock="Bottom"/>

        <Grid>
            <DataGrid x:Name="Grid" Style="{StaticResource ModernDataGrid}" Margin="24"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource AuditLog.Time}" Width="170">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource DateToCalendarConverter}" ConverterParameter="datetime" Mode="OneWay">
                                <Binding Path="Timestamp"/>
                                <Binding Source="{x:Static helpers:AppSessionProxy.Instance}" Path="IsShamsi"/>
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="{DynamicResource AuditLog.User}" Binding="{Binding UserName}" Width="*"/>
                    <DataGridTextColumn Header="{DynamicResource AuditLog.Action}" Binding="{Binding Action}" Width="*"/>
                    <DataGridTextColumn Header="{DynamicResource AuditLog.Entity}" Binding="{Binding EntityName}" Width="*"/>
                    <DataGridTextColumn Header="{DynamicResource AuditLog.Details}" Binding="{Binding Details}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="EmptyText" Text="{DynamicResource AuditLog.Empty}" Visibility="Collapsed"
                       FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </DockPanel>
</UserControl>
