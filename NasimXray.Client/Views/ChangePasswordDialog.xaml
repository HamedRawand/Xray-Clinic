<Window x:Class="NasimXray.Client.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NasimXray.Client.Helpers"
        Title="{DynamicResource ChangePassword.Title}"
        Height="420" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FlowDirection="{Binding Source={x:Static helpers:AppSessionProxy.Instance}, Path=FlowDirection}">
    <Border Style="{StaticResource CardBorder}" Margin="16">
        <StackPanel>
            <TextBlock x:Name="RequiredText" Text="{DynamicResource ChangePassword.Required}"
                       FontSize="12" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                       Margin="0,0,0,12" Visibility="Collapsed"/>

            <TextBlock Text="{DynamicResource ChangePassword.Current}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="CurrentBox" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,12" FlowDirection="LeftToRight"/>

            <TextBlock Text="{DynamicResource ChangePassword.New}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="NewBox" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,12" FlowDirection="LeftToRight"/>

            <TextBlock Text="{DynamicResource ChangePassword.Confirm}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="ConfirmBox" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,4" FlowDirection="LeftToRight"/>

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="{DynamicResource PatientEdit.Cancel}" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="{DynamicResource ChangePassword.Submit}" Style="{StaticResource PrimaryButton}"
                        Click="Submit_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
