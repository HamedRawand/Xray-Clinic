<UserControl x:Class="NasimXray.Client.Views.ReferringPhysiciansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <TextBlock Text="{DynamicResource RefPhysicians.Title}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <Button Content="{DynamicResource RefPhysicians.New}" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right" Click="New_Click"/>
            </Grid>
        </Border>

        <DataGrid x:Name="Grid" Style="{StaticResource ModernDataGrid}" Margin="24"
                  AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="Grid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource RefPhysicians.Name}" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="{DynamicResource RefPhysicians.Clinic}" Binding="{Binding ClinicName}" Width="2*"/>
                <DataGridTextColumn Header="{DynamicResource RefPhysicians.Phone}" Binding="{Binding PhoneNumber}" Width="*"/>
                <DataGridCheckBoxColumn Header="{DynamicResource ExamTypes.Active}" Binding="{Binding IsActive}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
