<Window x:Class="NasimXray.Client.Views.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NasimXray.Client.Helpers"
        Title="{DynamicResource ResetPassword.Title}"
        Height="320" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FlowDirection="{Binding Source={x:Static helpers:AppSessionProxy.Instance}, Path=FlowDirection}">
    <Border Style="{StaticResource CardBorder}" Margin="16">
        <StackPanel>
            <TextBlock Text="{DynamicResource ResetPassword.NewPassword}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,8" FlowDirection="LeftToRight"/>

            <TextBlock Text="{DynamicResource ResetPassword.Note}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{DynamicResource PatientEdit.Cancel}" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="{DynamicResource ResetPassword.Submit}" Style="{StaticResource PrimaryButton}"
                        Click="Submit_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
