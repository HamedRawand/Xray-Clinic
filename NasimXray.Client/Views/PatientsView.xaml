<UserControl x:Class="NasimXray.Client.Views.PatientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource Patients.Title}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,24,0"/>
                <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                         Width="320" HorizontalAlignment="Left"
                         Text="" TextChanged="SearchBox_TextChanged"/>
                <Button Grid.Column="2" Content="{DynamicResource Patients.New}" Style="{StaticResource PrimaryButton}"
                        Click="NewPatient_Click"/>
            </Grid>
        </Border>

        <Grid>
            <DataGrid x:Name="Grid" Style="{StaticResource ModernDataGrid}" Margin="24"
                      AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="Grid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Patients.Code}" Binding="{Binding PatientCode}" Width="90"/>
                    <DataGridTextColumn Header="{DynamicResource Patients.Name}" Binding="{Binding FullName}" Width="2*"/>
                    <DataGridTextColumn Header="{DynamicResource Patients.Sex}" Binding="{Binding Sex}" Width="90"/>
                    <DataGridTextColumn Header="{DynamicResource Patients.Phone}" Binding="{Binding PhoneNumber}" Width="*"/>
                    <DataGridTemplateColumn Header="" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{DynamicResource Patients.Open}" Style="{StaticResource SecondaryButton}"
                                        Height="28" Padding="10,0" FontSize="11" Click="OpenPatient_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush20}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
            </DataGrid>

            <TextBlock x:Name="EmptyText" Text="{DynamicResource Patients.Empty}" Visibility="Collapsed"
                       FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </DockPanel>
</UserControl>
