<Window x:Class="NasimXray.Client.Views.CancelExamDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NasimXray.Client.Helpers"
        Title="{DynamicResource CancelExam.Title}"
        Height="330" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FlowDirection="{Binding Source={x:Static helpers:AppSessionProxy.Instance}, Path=FlowDirection}">
    <Border Style="{StaticResource CardBorder}" Margin="16">
        <StackPanel>
            <TextBlock x:Name="ExamText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

            <TextBlock Text="{DynamicResource CancelExam.Reason}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="ReasonBox" Style="{StaticResource ModernTextBox}" Height="80" MaxLength="250"
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10,8"/>

            <TextBlock Text="{DynamicResource CancelExam.Note}" FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="{DynamicResource CancelExam.Keep}" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="{DynamicResource CancelExam.Submit}" Style="{StaticResource DangerButton}"
                        Click="Submit_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
