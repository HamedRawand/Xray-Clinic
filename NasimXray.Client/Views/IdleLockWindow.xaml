<Window x:Class="NasimXray.Client.Views.IdleLockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NasimXray.Client.Helpers"
        Title="{DynamicResource IdleLock.Title}"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Topmost="True" ShowInTaskbar="False"
        Background="#CC0B2A30"
        FlowDirection="{Binding Source={x:Static helpers:AppSessionProxy.Instance}, Path=FlowDirection}">
    <Grid>
        <Border Style="{StaticResource CardBorder}" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Viewbox Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Canvas Width="24" Height="24">
                        <Path Fill="{DynamicResource AccentBrush}"
                              Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"/>
                    </Canvas>
                </Viewbox>

                <TextBlock Text="{DynamicResource IdleLock.Title}" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="UserText" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock Text="{DynamicResource IdleLock.Message}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16"/>

                <TextBlock Text="{DynamicResource IdleLock.Password}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,4"
                             FlowDirection="LeftToRight" KeyDown="PasswordBox_KeyDown"/>

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

                <Button x:Name="UnlockButton" Content="{DynamicResource IdleLock.Unlock}" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch" Margin="0,16,0,8" Click="Unlock_Click"/>
                <Button Content="{DynamicResource IdleLock.SignOutInstead}" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Stretch" Click="SignOut_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
