<Window x:Class="NasimXray.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NasimXray.Client.Helpers"
        Title="{DynamicResource App.Title}"
        Height="720" Width="1180" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding Source={x:Static helpers:AppSessionProxy.Instance}, Path=FlowDirection}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid Height="56">
                <TextBlock Text="{DynamicResource App.Title}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="UserText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="LanguageButton" Content="{DynamicResource Login.Language}"
                            Style="{StaticResource SecondaryButton}"
                            Height="32" Padding="12,0" FontSize="12" Margin="0,0,8,0"
                            Click="LanguageToggle_Click"/>
                    <Button Content="{DynamicResource ChangePassword.MenuItem}" Style="{StaticResource SecondaryButton}"
                            Height="32" Padding="12,0" FontSize="12" Margin="0,0,8,0"
                            Click="ChangePassword_Click"/>
                    <Button Content="{DynamicResource Common.SignOut}" Style="{StaticResource SecondaryButton}"
                            Height="32" Padding="12,0" FontSize="12" Click="SignOut_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Left"
                Width="200" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="8">
                <Button x:Name="NavPatients" Content="{DynamicResource Nav.Patients}"
                        Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left"
                        HorizontalAlignment="Stretch" Height="38" Margin="0,4" Click="NavPatients_Click"/>
                <Button x:Name="NavInvoices" Content="{DynamicResource Nav.Invoices}"
                        Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left"
                        HorizontalAlignment="Stretch" Height="38" Margin="0,4" Click="NavInvoices_Click"/>
                <Button x:Name="NavExamTypes" Content="{DynamicResource Nav.ExamTypes}"
                        Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left"
                        HorizontalAlignment="Stretch" Height="38" Margin="0,4" Click="NavExamTypes_Click"/>
                <Button x:Name="NavReferringPhysicians" Content="{DynamicResource Nav.ReferringPhysicians}"
                        Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left"
                        HorizontalAlignment="Stretch" Height="38" Margin="0,4" Click="NavReferringPhysicians_Click"/>

                <Separator Margin="0,8" Background="{DynamicResource SeparatorBrush}"/>

                <Button x:Name="NavUsers" Content="{DynamicResource Nav.Users}"
                        Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left"
                        HorizontalAlignment="Stretch" Height="38" Margin="0,4" Click="NavUsers_Click" Visibility="Collapsed"/>
                <Button x:Name="NavCustomRoles" Content="{DynamicResource Nav.CustomRoles}"
                        Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left"
                        HorizontalAlignment="Stretch" Height="38" Margin="0,4" Click="NavCustomRoles_Click" Visibility="Collapsed"/>
                <Button x:Name="NavAuditLog" Content="{DynamicResource Nav.AuditLog}"
                        Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left"
                        HorizontalAlignment="Stretch" Height="38" Margin="0,4" Click="NavAuditLog_Click" Visibility="Collapsed"/>
                <Button x:Name="NavBackup" Content="{DynamicResource Nav.Backup}"
                        Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left"
                        HorizontalAlignment="Stretch" Height="38" Margin="0,4" Click="NavBackup_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Grid x:Name="ContentHost" Background="{DynamicResource PrimaryBrush}"/>
    </DockPanel>
</Window>
