<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds the PDF manual (installation and configuration guide). Screenshots come from tools/ManualScreens (images folder).
       Arguments: output pdf path, version text. -->
  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2024.10.4" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
  </PropertyGroup>
</Project>
